{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://story2u.github.io/dao/schemas/resolution-record.schema.json",
  "title": "Resolution Record",
  "description": "Append-only future outcome and scoring record. Contract version 0.2.1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resolution_id",
    "forecast_id",
    "frame_id",
    "resolved_at",
    "protocol_version",
    "source_snapshot_ref",
    "status",
    "observed",
    "scoring",
    "audit",
    "provenance"
  ],
  "properties": {
    "resolution_id": {"type": "string", "minLength": 1},
    "forecast_id": {"type": "string", "minLength": 1},
    "frame_id": {"type": "string", "minLength": 1},
    "resolved_at": {"type": "string", "format": "date-time"},
    "protocol_version": {
      "enum": [
        "xauusd-direction-5d:0.2.0",
        "gc-kaggle-daily-direction-5d:0.1.0"
      ]
    },
    "source_snapshot_ref": {"type": "string", "minLength": 1},
    "status": {"enum": ["resolved", "unresolvable", "not_scored"]},
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_close",
        "diagnostic_close_3",
        "resolution_close_5",
        "atr20_at_cutoff",
        "normalized_change_3",
        "normalized_change_5",
        "outcome_id"
      ],
      "properties": {
        "reference_close": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "diagnostic_close_3": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "resolution_close_5": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "atr20_at_cutoff": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "normalized_change_3": {"type": ["number", "null"]},
        "normalized_change_5": {"type": ["number", "null"]},
        "outcome_id": {"enum": ["up", "down", "range", null]}
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible",
        "exclusion_reasons",
        "brier_multiclass",
        "log_loss",
        "baseline_brier",
        "brier_skill_score"
      ],
      "properties": {
        "eligible": {"type": "boolean"},
        "exclusion_reasons": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "brier_multiclass": {"type": ["number", "null"], "minimum": 0},
        "log_loss": {"type": ["number", "null"], "minimum": 0},
        "baseline_brier": {"type": ["number", "null"], "minimum": 0},
        "brier_skill_score": {"type": ["number", "null"]}
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "append_only",
        "forecast_frozen_before_outcomes",
        "resolver_ref",
        "notes"
      ],
      "properties": {
        "append_only": {"const": true},
        "forecast_frozen_before_outcomes": {"type": "boolean"},
        "resolver_ref": {"type": "string", "minLength": 1},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "resolver_version"],
      "properties": {
        "contract_version": {"enum": ["0.2.1", "0.3.0"]},
        "resolver_version": {"enum": ["resolution:0.1.0", "gc-resolution:0.1.0"]}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["status"],
        "properties": {"status": {"const": "resolved"}}
      },
      "then": {
        "properties": {
          "observed": {
            "properties": {
              "reference_close": {"type": "number"},
              "diagnostic_close_3": {"type": "number"},
              "resolution_close_5": {"type": "number"},
              "atr20_at_cutoff": {"type": "number"},
              "normalized_change_3": {"type": "number"},
              "normalized_change_5": {"type": "number"},
              "outcome_id": {"enum": ["up", "down", "range"]}
            }
          },
          "scoring": {
            "properties": {
              "eligible": {"const": true},
              "exclusion_reasons": {"maxItems": 0},
              "brier_multiclass": {"type": "number"},
              "log_loss": {"type": "number"},
              "baseline_brier": {"type": "number"},
              "brier_skill_score": {"type": "number"}
            }
          },
          "audit": {
            "properties": {
              "forecast_frozen_before_outcomes": {"const": true}
            }
          }
        }
      },
      "else": {
        "properties": {
          "observed": {
            "properties": {
              "outcome_id": {"type": "null"}
            }
          },
          "scoring": {
            "properties": {
              "eligible": {"const": false},
              "exclusion_reasons": {"minItems": 1},
              "brier_multiclass": {"type": "null"},
              "log_loss": {"type": "null"},
              "baseline_brier": {"type": "null"},
              "brier_skill_score": {"type": "null"}
            }
          }
        }
      }
    }
  ]
}
