{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://story2u.github.io/dao/schemas/evidence-manifest.schema.json",
  "title": "Private Evidence Manifest",
  "description": "Non-secret metadata and hashes for a private point-in-time evidence bundle. Contract version 0.2.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "manifest_id",
    "instrument",
    "provider",
    "as_of",
    "data_cutoff",
    "licence",
    "snapshots",
    "coverage",
    "quality",
    "provenance"
  ],
  "properties": {
    "contract_version": {"enum": ["0.2.0", "0.3.0"]},
    "manifest_id": {"type": "string", "minLength": 1},
    "instrument": {
      "anyOf": [
        {"const": "XAUUSD"},
        {"type": "string", "pattern": "^GC[FGHJKMNQUVXZ][0-9]{2}$"}
      ]
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "instrument_id",
        "environment",
        "qualification_version"
      ],
      "properties": {
        "provider_id": {"enum": ["oanda-v20", "cme-licensed-snapshot"]},
        "instrument_id": {"type": "string", "minLength": 1},
        "environment": {"enum": ["practice", "live", "production"]},
        "account_instrument_verified": {"const": true},
        "instrument_verified": {"const": true},
        "qualification_version": {
          "enum": ["data-source-qualification:0.1.0", "data-source-qualification:0.2.0"]
        }
      }
    },
    "futures_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_code",
        "contract_code",
        "venue",
        "contract_month",
        "first_position_date",
        "last_trade_date",
        "contract_size_oz",
        "tick_size",
        "currency",
        "price_unit",
        "continuous",
        "roll_policy",
        "daily_reference_price_field",
        "exchange_timezone",
        "calendar_id",
        "calendar_version",
        "resolution_sessions",
        "resolution_session_sequence_sha256"
      ],
      "properties": {
        "product_code": {"const": "GC"},
        "contract_code": {
          "type": "string",
          "pattern": "^GC[FGHJKMNQUVXZ][0-9]{2}$"
        },
        "venue": {"const": "COMEX"},
        "contract_month": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
        },
        "first_position_date": {"type": "string", "format": "date"},
        "last_trade_date": {"type": "string", "format": "date"},
        "contract_size_oz": {"const": 100},
        "tick_size": {"const": 0.1},
        "currency": {"const": "USD"},
        "price_unit": {"const": "troy_ounce"},
        "continuous": {"const": false},
        "roll_policy": {"const": "none"},
        "daily_reference_price_field": {"const": "settlement"},
        "exchange_timezone": {"const": "America/Chicago"},
        "calendar_id": {"const": "cme-gc-settlement"},
        "calendar_version": {"const": "0.1.0"},
        "resolution_sessions": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"type": "string", "format": "date-time"}
        },
        "resolution_session_sequence_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "as_of": {"type": "string", "format": "date-time"},
    "data_cutoff": {"type": "string", "format": "date-time"},
    "licence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "region_or_entity",
        "version_or_effective_date",
        "locator",
        "usage_scope",
        "accepted_by_account_holder",
        "verified_at"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "region_or_entity": {"type": "string", "minLength": 1},
        "version_or_effective_date": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "format": "uri"},
        "usage_scope": {"const": "internal_evaluation"},
        "accepted_by_account_holder": {"const": true},
        "verified_at": {"type": "string", "format": "date-time"}
      }
    },
    "snapshots": {
      "type": "array",
      "minItems": 6,
      "items": {"$ref": "#/$defs/snapshot"},
      "allOf": [
        {"contains": {"properties": {"role": {"const": "instrument_spec"}}, "required": ["role"]}, "minContains": 1},
        {"contains": {"properties": {"role": {"const": "price_daily"}}, "required": ["role"]}, "minContains": 1},
        {"contains": {"properties": {"role": {"const": "price_h4"}}, "required": ["role"]}, "minContains": 1},
        {"contains": {"properties": {"role": {"const": "macro_rates"}}, "required": ["role"]}, "minContains": 1},
        {"contains": {"properties": {"role": {"const": "macro_usd"}}, "required": ["role"]}, "minContains": 1},
        {"contains": {"properties": {"role": {"const": "event_clock"}}, "required": ["role"]}, "minContains": 1}
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "daily_complete_bars",
        "h4_complete_bars",
        "last_daily_complete_at",
        "last_h4_complete_at"
      ],
      "properties": {
        "daily_complete_bars": {"type": "integer", "minimum": 60},
        "h4_complete_bars": {"type": "integer", "minimum": 30},
        "last_daily_complete_at": {"type": "string", "format": "date-time"},
        "last_h4_complete_at": {"type": "string", "format": "date-time"}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missing_intervals", "stale", "future_records", "notes"],
      "properties": {
        "missing_intervals": {
          "type": "array",
          "maxItems": 0,
          "items": {"type": "string", "minLength": 1}
        },
        "stale": {"const": false},
        "future_records": {"const": false},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_at",
        "created_by",
        "runtime_version",
        "source_policy_version"
      ],
      "properties": {
        "created_at": {"type": "string", "format": "date-time"},
        "created_by": {"type": "string", "minLength": 1},
        "runtime_version": {
          "enum": ["dao-certified-runtime:0.2.0", "dao-certified-runtime:0.3.0"]
        },
        "source_policy_version": {
          "enum": ["data-source-qualification:0.1.0", "data-source-qualification:0.2.0"]
        }
      }
    }
  },
  "$defs": {
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "role",
        "private_location_ref",
        "request_locator_redacted",
        "request_id",
        "source_locator",
        "captured_at",
        "available_at",
        "sha256",
        "source_response_location_ref",
        "source_response_sha256",
        "bytes",
        "record_count",
        "first_observed_at",
        "last_observed_at",
        "source_timezone",
        "timestamp_semantics",
        "complete_only",
        "transform_id",
        "freshness_max_seconds"
      ],
      "properties": {
        "snapshot_id": {"type": "string", "minLength": 1},
        "role": {
          "enum": [
            "instrument_spec",
            "contract_calendar",
            "price_daily",
            "price_h4",
            "macro_rates",
            "macro_usd",
            "event_clock",
            "positioning",
            "other"
          ]
        },
        "private_location_ref": {
          "description": "Opaque private reference resolved only inside the licensed runtime.",
          "type": "string",
          "pattern": "^private://[A-Za-z0-9._/-]+$"
        },
        "request_locator_redacted": {"type": "string", "minLength": 1},
        "request_id": {"type": ["string", "null"]},
        "source_locator": {"type": "string", "format": "uri"},
        "captured_at": {"type": "string", "format": "date-time"},
        "available_at": {"type": "string", "format": "date-time"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_response_location_ref": {
          "type": ["string", "null"],
          "pattern": "^private://[A-Za-z0-9._/-]+$"
        },
        "source_response_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {"type": "integer", "minimum": 1},
        "record_count": {"type": "integer", "minimum": 1},
        "first_observed_at": {"type": "string", "format": "date-time"},
        "last_observed_at": {"type": "string", "format": "date-time"},
        "source_timezone": {"type": "string", "minLength": 1},
        "timestamp_semantics": {
          "enum": [
            "open_time",
            "publication_time",
            "event_time",
            "session_close",
            "bar_start",
            "not_applicable"
          ]
        },
        "complete_only": {"const": true},
        "transform_id": {"type": "string", "minLength": 1},
        "freshness_max_seconds": {"type": "integer", "minimum": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"instrument": {"const": "XAUUSD"}}},
      "then": {
        "properties": {
          "contract_version": {"const": "0.2.0"},
          "provider": {
            "required": ["account_instrument_verified"],
            "properties": {
              "provider_id": {"const": "oanda-v20"},
              "instrument_id": {"const": "XAU_USD"},
              "environment": {"enum": ["practice", "live"]},
              "qualification_version": {"const": "data-source-qualification:0.1.0"}
            }
          }
        }
      },
      "else": {
        "required": ["futures_contract"],
        "properties": {
          "contract_version": {"const": "0.3.0"},
          "provider": {
            "required": ["instrument_verified"],
            "properties": {
              "provider_id": {"const": "cme-licensed-snapshot"},
              "environment": {"const": "production"},
              "qualification_version": {"const": "data-source-qualification:0.2.0"}
            }
          },
          "snapshots": {
            "contains": {
              "properties": {"role": {"const": "contract_calendar"}},
              "required": ["role"]
            },
            "minContains": 1
          }
        }
      }
    }
  ]
}
