{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://story2u.github.io/dao/schemas/market-cognition-frame.schema.json",
  "title": "Market Cognition Frame",
  "description": "Auditable market belief state. Contract version 2.1.0 with Q0 migration support.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "frame_id",
    "instrument",
    "as_of",
    "data_cutoff",
    "horizon",
    "state",
    "change_model",
    "evidence_refs",
    "counterevidence_refs",
    "scenarios",
    "invalidation_conditions",
    "risk",
    "abstention",
    "provenance"
  ],
  "properties": {
    "frame_id": {"type": "string", "minLength": 1},
    "instrument": {"enum": ["XAUUSD", "GC"]},
    "as_of": {"type": "string", "format": "date-time"},
    "data_cutoff": {"type": "string", "format": "date-time"},
    "horizon": {"type": "string", "minLength": 1},
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "lifecycle", "stability", "posterior"],
      "properties": {
        "direction": {"enum": ["up", "down", "range", "uncertain"]},
        "lifecycle": {
          "enum": ["formation", "expansion", "maturity", "exhaustion", "transition"]
        },
        "stability": {"enum": ["stable", "fragile", "critical"]},
        "posterior": {
          "type": "object",
          "additionalProperties": false,
          "required": ["up", "down", "range"],
          "properties": {
            "up": {"type": "number", "minimum": 0, "maximum": 1},
            "down": {"type": "number", "minimum": 0, "maximum": 1},
            "range": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    },
    "change_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xing", "shi", "ji", "shi_temporal", "wei", "xin"],
      "properties": {
        "xing": {"type": "string", "minLength": 1},
        "shi": {"type": "number", "minimum": -1, "maximum": 1},
        "ji": {"type": "number", "minimum": 0, "maximum": 1},
        "shi_temporal": {"type": "string", "minLength": 1},
        "wei": {
          "enum": ["formation", "expansion", "maturity", "exhaustion", "transition"]
        },
        "xin": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "counterevidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "scenarios": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "resolution_outcome_id",
          "description",
          "probability",
          "triggers"
        ],
        "properties": {
          "scenario_id": {"type": "string", "minLength": 1},
          "resolution_outcome_id": {"enum": ["up", "down", "range"]},
          "description": {"type": "string", "minLength": 1},
          "probability": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1
          },
          "triggers": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "invalidation_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "research_posture", "warnings"],
      "properties": {
        "level": {"enum": ["low", "medium", "high", "blocked"]},
        "research_posture": {
          "enum": [
            "observe",
            "investigate",
            "wait_for_data",
            "simulate_only",
            "do_not_publish"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "abstention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "forecast"],
      "properties": {
        "state": {"$ref": "#/$defs/abstentionDecision"},
        "forecast": {"$ref": "#/$defs/abstentionDecision"}
      }
    },
    "data_gaps": {
      "type": "array",
      "items": {"type": "string"}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_snapshot",
        "feature_version",
        "model_versions",
        "contract_version",
        "certification_level"
      ],
      "properties": {
        "data_snapshot": {"type": "string", "minLength": 1},
        "feature_version": {"type": "string", "minLength": 1},
        "model_versions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "prompt_version": {"type": ["string", "null"]},
        "contract_version": {"enum": ["2.0.0-q0", "2.1.0", "2.2.0"]},
        "certification_level": {"enum": ["Q0", "Q1", "Q2", "Q3"]},
        "resolution_protocol_version": {"type": ["string", "null"]}
      }
    }
  },
  "$defs": {
    "abstentionDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["abstain", "reason_codes", "reason"],
      "properties": {
        "abstain": {"type": "boolean"},
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "insufficient_data",
              "temporal_integrity",
              "evidence_conflict",
              "out_of_distribution",
              "unmodelled_event",
              "uncalibrated",
              "unresolvable_state",
              "unresolvable_outcomes",
              "model_failure",
              "other"
            ]
          }
        },
        "reason": {"type": ["string", "null"]}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"instrument": {"const": "XAUUSD"}}},
      "then": {
        "properties": {
          "provenance": {
            "properties": {
              "contract_version": {"enum": ["2.0.0-q0", "2.1.0"]}
            }
          }
        }
      },
      "else": {
        "properties": {
          "provenance": {
            "properties": {
              "contract_version": {"const": "2.2.0"},
              "resolution_protocol_version": {
                "const": "gc-kaggle-daily-direction-5d:0.1.0"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "properties": {
              "direction": {"const": "range"}
            }
          }
        }
      },
      "then": {
        "properties": {
          "state": {
            "properties": {
              "lifecycle": {
                "enum": ["formation", "maturity", "transition"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "abstention": {
            "properties": {
              "forecast": {
                "properties": {
                  "abstain": {"const": true}
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "scenarios": {
            "items": {
              "properties": {
                "probability": {"type": "null"}
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "scenarios": {
            "items": {
              "properties": {
                "probability": {"type": "number"}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provenance": {
            "required": ["certification_level"],
            "properties": {
              "certification_level": {"enum": ["Q1", "Q2", "Q3"]}
            }
          }
        }
      },
      "then": {
        "properties": {
          "provenance": {
            "properties": {
              "contract_version": {"enum": ["2.1.0", "2.2.0"]}
            }
          },
          "abstention": {
            "properties": {
              "state": {
                "properties": {
                  "abstain": {"const": false},
                  "reason_codes": {"maxItems": 0},
                  "reason": {"type": "null"}
                }
              },
              "forecast": {
                "properties": {
                  "abstain": {"const": false},
                  "reason_codes": {"maxItems": 0},
                  "reason": {"type": "null"}
                }
              }
            }
          }
        }
      }
    }
  ]
}
