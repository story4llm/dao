{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://story2u.github.io/dao/schemas/cognition-delta.schema.json",
  "title": "Cognition Delta",
  "description": "Append-only explanation of how and why a belief state changed. Contract version 0.2.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "delta_id",
    "previous_frame_id",
    "current_frame_id",
    "previous_data_cutoff",
    "current_data_cutoff",
    "created_at",
    "added_evidence_refs",
    "removed_evidence_refs",
    "state_transition",
    "posterior_delta",
    "scenario_updates",
    "revision_drivers",
    "triggered_conditions",
    "interpretation",
    "temporal_audit",
    "provenance"
  ],
  "properties": {
    "delta_id": {"type": "string", "minLength": 1},
    "previous_frame_id": {"type": "string", "minLength": 1},
    "current_frame_id": {"type": "string", "minLength": 1},
    "previous_data_cutoff": {"type": "string", "format": "date-time"},
    "current_data_cutoff": {"type": "string", "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"},
    "added_evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "removed_evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "state_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "before": {"$ref": "#/$defs/stateLabel"},
        "after": {"$ref": "#/$defs/stateLabel"}
      }
    },
    "posterior_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["up", "down", "range"],
      "properties": {
        "up": {"type": "number", "minimum": -1, "maximum": 1},
        "down": {"type": "number", "minimum": -1, "maximum": 1},
        "range": {"type": "number", "minimum": -1, "maximum": 1}
      }
    },
    "scenario_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resolution_outcome_id",
          "previous_probability",
          "current_probability",
          "delta"
        ],
        "properties": {
          "resolution_outcome_id": {"enum": ["up", "down", "range"]},
          "previous_probability": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "current_probability": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "delta": {"type": ["number", "null"], "minimum": -1, "maximum": 1}
        }
      }
    },
    "revision_drivers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "new_evidence",
          "data_correction",
          "model_change",
          "rule_change",
          "prompt_change",
          "time_passage"
        ]
      }
    },
    "triggered_conditions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "interpretation": {"type": "string", "minLength": 1},
    "temporal_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["future_evidence_used", "notes"],
      "properties": {
        "future_evidence_used": {"const": false},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "model_versions"],
      "properties": {
        "contract_version": {"const": "0.2.0"},
        "model_versions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "stateLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "lifecycle", "stability"],
      "properties": {
        "direction": {"enum": ["up", "down", "range", "uncertain"]},
        "lifecycle": {
          "enum": ["formation", "expansion", "maturity", "exhaustion", "transition"]
        },
        "stability": {"enum": ["stable", "fragile", "critical"]}
      }
    }
  }
}
