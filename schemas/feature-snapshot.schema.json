{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://story2u.github.io/dao/schemas/feature-snapshot.schema.json",
  "title": "Frozen Feature Snapshot",
  "description": "Program-computed values frozen before a forecast. Contract version 0.1.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "feature_snapshot_id",
    "instrument",
    "data_cutoff",
    "source_manifest_id",
    "reference_session",
    "reference_price_field",
    "reference_close",
    "atr20",
    "bar_config",
    "trading_calendar",
    "feature_payload_sha256",
    "provenance"
  ],
  "properties": {
    "contract_version": {"const": "0.1.0"},
    "feature_snapshot_id": {"type": "string", "minLength": 1},
    "instrument": {"const": "XAUUSD"},
    "data_cutoff": {"type": "string", "format": "date-time"},
    "source_manifest_id": {"type": "string", "minLength": 1},
    "reference_session": {"type": "string", "format": "date-time"},
    "reference_price_field": {"const": "mid.c"},
    "reference_close": {"type": "number", "exclusiveMinimum": 0},
    "atr20": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "lookback_true_ranges",
        "required_complete_bars",
        "value",
        "input_snapshot_sha256",
        "calculation_version"
      ],
      "properties": {
        "method": {"const": "wilder_atr_seed_mean"},
        "lookback_true_ranges": {"const": 20},
        "required_complete_bars": {"const": 21},
        "value": {"type": "number", "exclusiveMinimum": 0},
        "input_snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "calculation_version": {"const": "wilder-atr-seed20:0.1.0"}
      }
    },
    "bar_config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "granularity",
        "price_component",
        "daily_alignment",
        "alignment_timezone",
        "timestamp_semantics"
      ],
      "properties": {
        "granularity": {"const": "D"},
        "price_component": {"const": "M"},
        "daily_alignment": {"const": 17},
        "alignment_timezone": {"const": "America/New_York"},
        "timestamp_semantics": {"const": "open_time"}
      }
    },
    "trading_calendar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calendar_id", "version", "session_sequence_sha256"],
      "properties": {
        "calendar_id": {"const": "oanda-xauusd-ny17"},
        "version": {"const": "0.1.0"},
        "session_sequence_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "feature_payload_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_at", "runtime_version"],
      "properties": {
        "created_at": {"type": "string", "format": "date-time"},
        "runtime_version": {"const": "dao-certified-runtime:0.2.0"}
      }
    }
  }
}
