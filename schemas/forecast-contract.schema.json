{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://story2u.github.io/dao/schemas/forecast-contract.schema.json",
  "title": "Forecast Contract",
  "description": "Pre-registered probabilistic forecast contract. Contract version 2.1.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "forecast_id",
    "frame_id",
    "question",
    "instrument",
    "created_at",
    "data_cutoff",
    "horizon",
    "outcomes",
    "baseline",
    "resolution_rule",
    "invalidation_conditions",
    "forecast_abstention",
    "status",
    "model_versions"
  ],
  "properties": {
    "contract_version": {"const": "2.1.0"},
    "forecast_id": {"type": "string", "minLength": 1},
    "frame_id": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "instrument": {"const": "XAUUSD"},
    "created_at": {"type": "string", "format": "date-time"},
    "data_cutoff": {"type": "string", "format": "date-time"},
    "horizon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "primary_sessions",
        "diagnostic_sessions",
        "starts_after_cutoff"
      ],
      "properties": {
        "unit": {"const": "completed_trading_session"},
        "primary_sessions": {"const": 5},
        "diagnostic_sessions": {"const": [3]},
        "starts_after_cutoff": {"const": true}
      }
    },
    "outcomes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["outcome_id", "description", "probability"],
        "properties": {
          "outcome_id": {"enum": ["up", "down", "range"]},
          "description": {"type": "string", "minLength": 1},
          "probability": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_ref",
        "method",
        "probabilities",
        "version",
        "sample_size",
        "training_start",
        "training_end",
        "frozen_at",
        "source_snapshot_sha256"
      ],
      "properties": {
        "baseline_ref": {"type": "string", "minLength": 1},
        "method": {"const": "rolling_historical_frequency"},
        "probabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["up", "down", "range"],
          "properties": {
            "up": {"type": "number", "minimum": 0, "maximum": 1},
            "down": {"type": "number", "minimum": 0, "maximum": 1},
            "range": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "version": {"const": "baseline:0.1.0"},
        "sample_size": {"type": "integer", "minimum": 252},
        "training_start": {"type": "string", "format": "date-time"},
        "training_end": {"type": "string", "format": "date-time"},
        "frozen_at": {"type": "string", "format": "date-time"},
        "source_snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "counterevidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "resolution_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_id",
        "reference_price_field",
        "normalizer",
        "neutral_band_atr_multiple",
        "boundary_policy",
        "missing_data_policy",
        "frozen_values"
      ],
      "properties": {
        "protocol_id": {"const": "xauusd-direction-5d:0.2.0"},
        "reference_price_field": {"const": "mid.c"},
        "normalizer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "lookback_sessions", "freeze_at_cutoff"],
          "properties": {
            "method": {"const": "wilder_atr_seed_mean"},
            "lookback_sessions": {"const": 20},
            "freeze_at_cutoff": {"const": true}
          }
        },
        "neutral_band_atr_multiple": {"const": 0.5},
        "boundary_policy": {"const": "inclusive_range"},
        "missing_data_policy": {"const": "mark_unresolvable"},
        "frozen_values": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "feature_snapshot_ref",
            "feature_payload_sha256",
            "reference_session",
            "reference_close",
            "atr20_at_cutoff",
            "price_component",
            "daily_alignment",
            "alignment_timezone",
            "calendar_id",
            "calendar_version"
          ],
          "properties": {
            "feature_snapshot_ref": {"type": "string", "minLength": 1},
            "feature_payload_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "reference_session": {"type": "string", "format": "date-time"},
            "reference_close": {"type": "number", "exclusiveMinimum": 0},
            "atr20_at_cutoff": {"type": "number", "exclusiveMinimum": 0},
            "price_component": {"const": "M"},
            "daily_alignment": {"const": 17},
            "alignment_timezone": {"const": "America/New_York"},
            "calendar_id": {"const": "oanda-xauusd-ny17"},
            "calendar_version": {"const": "0.1.0"}
          }
        }
      }
    },
    "invalidation_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "forecast_abstention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["abstain", "reason_codes", "reason"],
      "properties": {
        "abstain": {"type": "boolean"},
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "reason": {"type": ["string", "null"]}
      }
    },
    "status": {"enum": ["open", "resolved", "cancelled", "not_scored"]},
    "model_versions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "forecast_abstention": {
            "required": ["abstain"],
            "properties": {"abstain": {"const": true}}
          }
        }
      },
      "then": {
        "properties": {
          "outcomes": {
            "items": {
              "properties": {"probability": {"type": "null"}}
            }
          },
          "forecast_abstention": {
            "properties": {
              "reason_codes": {"minItems": 1},
              "reason": {"type": "string", "minLength": 1}
            }
          },
          "status": {"const": "not_scored"}
        }
      },
      "else": {
        "properties": {
          "outcomes": {
            "items": {
              "properties": {"probability": {"type": "number"}}
            }
          },
          "forecast_abstention": {
            "properties": {
              "reason_codes": {"maxItems": 0},
              "reason": {"type": "null"}
            }
          },
          "status": {"const": "open"}
        }
      }
    }
  ]
}
