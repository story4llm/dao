{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://story2u.github.io/dao/schemas/forecast-contract.schema.json",
  "title": "Forecast Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "forecast_id",
    "question",
    "instrument",
    "created_at",
    "data_cutoff",
    "horizon",
    "outcomes",
    "baseline",
    "resolution_rule",
    "invalidation_conditions",
    "status"
  ],
  "properties": {
    "forecast_id": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "instrument": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "data_cutoff": {"type": "string", "format": "date-time"},
    "horizon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["starts_at", "ends_at"],
      "properties": {
        "starts_at": {"type": "string", "format": "date-time"},
        "ends_at": {"type": "string", "format": "date-time"}
      }
    },
    "outcomes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["outcome_id", "description", "probability"],
        "properties": {
          "outcome_id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "probability": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "probabilities"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "probabilities": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "counterevidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "resolution_rule": {"type": "string", "minLength": 1},
    "invalidation_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "abstain": {"type": "boolean", "default": false},
    "abstain_reason": {"type": ["string", "null"]},
    "status": {
      "enum": ["open", "resolved", "cancelled"]
    },
    "resolved_outcome_id": {"type": ["string", "null"]},
    "model_versions": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}

