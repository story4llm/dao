{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://story2u.github.io/dao/schemas/evidence-item.schema.json",
  "title": "Evidence Item",
  "description": "Point-in-time evidence contract. Contract version 2.0.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "layer",
    "kind",
    "claim",
    "dependency_group",
    "source",
    "source_timezone",
    "bar_timestamp_semantics",
    "observed_at",
    "available_at",
    "recorded_at",
    "availability_verified",
    "licence",
    "quality"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "layer": {
      "enum": ["classical", "modern", "official", "market"]
    },
    "kind": {
      "enum": ["observation", "inference", "hypothesis", "decision"]
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "dependency_group": {
      "description": "Evidence derived from the same underlying source must share one group.",
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "locator"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "author": {"type": ["string", "null"]},
        "locator": {"type": "string", "minLength": 1},
        "published_at": {"type": ["string", "null"], "format": "date-time"},
        "accessed_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "source_timezone": {
      "description": "IANA timezone, UTC, fixed offset, or unknown for Q0 evidence.",
      "type": "string",
      "minLength": 1
    },
    "bar_timestamp_semantics": {
      "enum": [
        "open_time",
        "close_time",
        "event_time",
        "publication_time",
        "not_applicable",
        "unknown"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "available_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "availability_verified": {
      "description": "True only when first availability is supported by retained source metadata.",
      "type": "boolean"
    },
    "vintage_id": {
      "description": "Point-in-time release or dataset version; null when not applicable or not captured.",
      "type": ["string", "null"]
    },
    "licence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "usage_scope", "verified"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "usage_scope": {
          "enum": [
            "unknown",
            "research_only",
            "internal_evaluation",
            "redistributable",
            "commercial"
          ]
        },
        "locator": {"type": ["string", "null"]},
        "verified": {"type": "boolean"}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reliability", "independence", "freshness"],
      "properties": {
        "reliability": {"type": "number", "minimum": 0, "maximum": 1},
        "independence": {"type": "number", "minimum": 0, "maximum": 1},
        "freshness": {"type": "number", "minimum": 0, "maximum": 1},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    }
  }
}
